# ──────────────────────────────────────────────
#  WhatsApp AI SaaS — Environment Variables
#  Copy to .env and fill in real values.
#  NEVER commit .env to version control.
# ──────────────────────────────────────────────

# ── Application ──────────────────────────────
ENVIRONMENT=development          # development | staging | production
DEBUG=true
SECRET_KEY=change-me-use-openssl-rand-hex-32

# ── PostgreSQL (Supabase-compatible) ─────────
POSTGRES_USER=whatsapp_user
POSTGRES_PASSWORD=whatsapp_pass
POSTGRES_DB=whatsapp_saas
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://whatsapp_user:whatsapp_pass@postgres:5432/whatsapp_saas

# ── Redis ────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ── Celery ───────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Document Storage ─────────────────────────
STORAGE_BACKEND=s3                  # supabase | s3
SUPABASE_URL=
SUPABASE_KEY=
S3_BUCKET=whatsapp-documents
S3_ENDPOINT_URL=

# ── WhatsApp / Meta ──────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Default is safe for local dev — MUST be changed in staging/production
WHATSAPP_VERIFY_TOKEN=dev-verify-token-change-me
WHATSAPP_APP_SECRET=dev-app-secret-change-me

# ── LLM / DeepSeek ───────────────────────────
DEEPSEEK_API_KEY=sk-...          # Get from https://platform.deepseek.com

# ── JWT ──────────────────────────────────────
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ── Langfuse Observability (TASK-014) ────────────────────────
# Get keys from https://cloud.langfuse.com  (or self-host via docker-compose)
LANGFUSE_PUBLIC_KEY=pk-lf-...           # public client key
LANGFUSE_SECRET_KEY=sk-lf-...           # secret server key
LANGFUSE_HOST=https://cloud.langfuse.com # override for self-hosted instance
